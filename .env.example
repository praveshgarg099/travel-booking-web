# ==============================================================================
# Travel Booking Web Application - Environment Configuration Template
# COPY THIS FILE TO .env OR SET THESE ENVIRONMENT VARIABLES BEFORE RUNNING
# ==============================================================================

# PostgreSQL Database Configuration
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password

# JWT Authentication Secret (Minimum 256 bits / 32 characters)
JWT_SECRET=yourSuperSecretKeyForTravelBookingApplicationMustBeLong123456789

# ==============================================================================
# Razorpay Payment Gateway Configuration
# CRITICAL SECURITY RULES:
# 1. RAZORPAY_KEY_ID is public to checkout clients.
# 2. RAZORPAY_KEY_SECRET and RAZORPAY_WEBHOOK_SECRET are STRICTLY PRIVATE.
#    NEVER commit secrets to Git or expose in frontend / API responses.
# ==============================================================================
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
