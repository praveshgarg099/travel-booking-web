# ==============================================================================
# Travel Booking Web Application - Production Environment Configuration Template
# DO NOT COMMIT ACTUAL SECRET VALUES TO GIT
# Configure these variables in your deployment platform dashboard or local .env
# ==============================================================================

# Server Port (configured by hosting provider e.g. Render / Railway / Heroku)
PORT=8080

# Spring Active Profile (set to 'prod' in production, or leave blank for local dev)
SPRING_PROFILES_ACTIVE=

# Managed PostgreSQL Database Configuration
# Provide either full JDBC URL or separate credentials
DATABASE_URL=
SPRING_DATASOURCE_URL=
DB_USERNAME=
DB_PASSWORD=

# JWT Authentication Secret (Minimum 256 bits / 32 characters)
JWT_SECRET=

# Production Frontend HTTPS URL for CORS (no trailing slash, e.g. https://your-travel-app.onrender.com)
FRONTEND_URL=

# ==============================================================================
# Razorpay Payment Gateway Configuration
# 1. RAZORPAY_KEY_ID is public to checkout clients.
# 2. RAZORPAY_KEY_SECRET & RAZORPAY_WEBHOOK_SECRET are STRICTLY PRIVATE.
#    NEVER commit secrets to Git or expose in frontend / API responses.
# ==============================================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ==============================================================================
# Google OAuth2 Client Configuration
# ==============================================================================
GOOGLE_CLIENT_ID=

# ==============================================================================
# Email Verification & SMTP Delivery Configuration
# Required for real OTP email delivery in production.
# When using Gmail:
#   SPRING_MAIL_HOST=smtp.gmail.com
#   SPRING_MAIL_PORT=587
#   SPRING_MAIL_USERNAME=your-email@gmail.com
#   SPRING_MAIL_PASSWORD=your-16-character-google-app-password
#   MAIL_FROM=your-email@gmail.com (or verified custom domain)
# ==============================================================================
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_FROM=
